rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Users collection rules
    match /users/{userId} {
      allow read, write: if true;
    }

    // Daily Shifts collection
    match /daily_shifts/{date} {
      allow read, write: if true;
    }

    // Audit Logs collection
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // Master Templates collection
    match /templates_op_groups/{manifestId} {
      allow read, write: if true;
    }

    // Connection test collection
    match /_connection_test/{docId} {
      allow read, write: if true;
    }
  }
}

